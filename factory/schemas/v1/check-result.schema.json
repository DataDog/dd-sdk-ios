  "properties": {
    "schema_version": {"const": 1}, "mode": {"enum": ["report-only", "gate"]}, "decision": {"enum": ["allow", "block", null]}, "candidate": {"type": "object"}, "comparison": {"type": ["object", "null"]}, "configuration": {"type": "object"}, "findings": {"type": "object"}, "coverage_limits": {"type": "array"}, "required_evaluation_errors": {"type": "array"}, "advisories": {"type": "array"}
  }
}
