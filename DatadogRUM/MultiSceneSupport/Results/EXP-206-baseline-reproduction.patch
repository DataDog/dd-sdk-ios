+        XCTAssertEqual(error.session.id, firstSession.sessionUUID.toRUMDataFormat)
+        XCTAssertEqual(error.view.id, firstViewID.toRUMDataFormat)
+        XCTAssertEqual(error.error.resource?.url, "https://example.com/stopped-error")
