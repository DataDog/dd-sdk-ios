+import Foundation
+
+struct SourceInventoryManifest: Decodable {
+    let module: String
+    let compilerArguments: [String]
+    let sources: [String]
+}
+
+struct SourceInventoryReceipt: Encodable {
+    let module: String
+    let expectedSources: [String]
+    let moduleSources: [String]
+    let documentedSources: [String]
+}
+
+enum SourceInventory {
+    static func validate(expected: [String], actual: [String]) throws {
+        let expected = expected.map { URL(fileURLWithPath: $0).resolvingSymlinksInPath().path }
+        let actual = actual.map { URL(fileURLWithPath: $0).resolvingSymlinksInPath().path }
+        guard !expected.isEmpty,
+              Set(expected).count == expected.count,
+              Set(actual).count == actual.count,
+              expected.sorted() == actual.sorted() else {
+            throw APISurfaceError(description: "Missing, duplicate or unexpected parsed source file.")
+        }
+    }
+}
