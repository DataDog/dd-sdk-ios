+import XCTest
+@testable import APISurfaceCore
+
+final class SourceInventoryTests: XCTestCase {
+    func testExactInventory() throws {
+        try SourceInventory.validate(expected: ["/a.swift", "/b.swift"], actual: ["/b.swift", "/a.swift"])
+    }
+    func testMissingSource() {
+        XCTAssertThrowsError(try SourceInventory.validate(expected: ["/a.swift", "/b.swift"], actual: ["/a.swift"]))
+    }
+    func testDuplicateSource() {
+        XCTAssertThrowsError(try SourceInventory.validate(expected: ["/a.swift", "/b.swift"], actual: ["/a.swift", "/a.swift"]))
+    }
+    func testUnexpectedSource() {
+        XCTAssertThrowsError(try SourceInventory.validate(expected: ["/a.swift"], actual: ["/b.swift"]))
+    }
+    func testEmptyInventory() {
+        XCTAssertThrowsError(try SourceInventory.validate(expected: [], actual: []))
+    }
+    func testDuplicateExpectedSource() {
+        XCTAssertThrowsError(try SourceInventory.validate(expected: ["/a.swift", "/a.swift"], actual: ["/a.swift", "/a.swift"]))
+    }
+}
