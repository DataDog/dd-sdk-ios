load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
load("@rules_apple//apple:ios.bzl", "ios_unit_test")

swift_library(
    name = "DatadogSessionReplay",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "DatadogSessionReplay",
    copts = ["-enable-testing"],
    deps = ["//DatadogInternal"],
    visibility = ["//visibility:public"],
)

swift_library(
    name = "DatadogSessionReplayTestsLib",
    srcs = glob(["Tests/**/*.swift"]),
    testonly = True,
    deps = [
        ":DatadogSessionReplay",
        "//TestUtilities",
    ],
)

ios_unit_test(
    name = "DatadogSessionReplayTests",
    bundle_id = "com.datadoghq.DatadogSessionReplayTests",
    minimum_os_version = "12.0",
    deps = [":DatadogSessionReplayTestsLib"],
    # TODO: Tests/Resources/Assets.xcassets — needs rules_apple resource handling
)
